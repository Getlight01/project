# ============================================
# API КЛЮЧИ ДЛЯ ВНЕШНИХ СЕРВИСОВ
# ============================================

# === GOOGLE VISION API (Анализ цвета и типа вещи) ===
# Получить: https://console.cloud.google.com/apis/credentials
# Бесплатно: 1000 запросов/месяц
GOOGLE_VISION_API_KEY=AIzaSyВАШ_КЛЮЧ_ЗДЕСЬ

# === REMOVE.BG API (Удаление фона с вещи) ===
# Получить: https://www.remove.bg/dashboard#api-key
# Бесплатно: 50 изображений/месяц
REMOVE_BG_API_KEY=sI3xВАШ_КЛЮЧ_ЗДЕСЬ

# === REPLICATE API (Виртуальная примерка на модель) ===
# Получить: https://replicate.com/account/api-tokens
# Стоимость: ~$0.01-0.03 за генерацию (минимум $5 на балансе)
REPLICATE_API_KEY=r8_ВАШ_ТОКЕН_ЗДЕСЬ
REPLICATE_MODEL=yisol/outfit-anyone

# ============================================
# НАСТРОЙКИ ПРИЛОЖЕНИЯ
# ============================================

# Порт сервера (по умолчанию 8085)
PORT=8085

# Режим работы (development/production)
ENV=development

# JWT секрет для токенов (сгенерируйте случайную строку)
JWT_SECRET=your_random_secret_key_here

# Путь к базе данных (SQLite по умолчанию)
DATABASE_URL=fashion.db
